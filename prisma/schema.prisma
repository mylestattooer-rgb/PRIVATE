// Trading School OS — Prisma schema
// SQLite for zero-infra local/dev persistence. Swap `provider`/`url` for Postgres in production.
//
// Pinned to Prisma 6.x (not the newly-released 7.x): v7 makes driver adapters mandatory even
// for SQLite, which is unnecessary complexity for a single-file local dev database. v6 is the
// well-documented, stable line and needs no adapter for this setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  notes          Note[]
  auditLogs      AuditLog[]
  approvals      Approval[]
  lessonVersions LessonVersion[]
}

enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  PAUSED
  CHURNED
}

model Student {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  status       StudentStatus @default(LEAD)
  source       String? // how they found the school (referral, ad, organic, etc.)
  joinedAt     DateTime      @default(now())
  lastActiveAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // --- Student-facing login (added Phase 1, DATABASE.md §2.1) ---------------
  // Nullable: a LEAD/TRIAL record can exist as a pure CRM row before the
  // student ever creates their own login. Set together when an account is
  // provisioned; both null means "CRM lead, no login yet".
  passwordHash  String?
  authEnabledAt DateTime?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  notes            Note[]
  progress         ModuleProgress[]
  conversations    Conversation[]
  journalTrades    JournalTrade[]
  crmActivities    CrmActivity[]
  questionAttempts QuestionAttempt[]
  xpEvents         XpEvent[]
  achievements     UserAchievement[]
  conceptMasteries ConceptMastery[]
  masteryEvents    ConceptMasteryEvent[]
  aiInsights       AiInsight[]
  chartAnswers     ChartAnswer[]
}

// --- Entitlements (ARCHITECTURE.md "central entitlements module") ----------

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  // Comma-separated capability strings (e.g. "USE_AI_TUTOR,CREATE_JOURNAL"),
  // matching the freeform-string style already used for Document.tags —
  // deliberately not an enum so new capabilities/plans never need a migration
  // to grant, only a data change (see app/lib/domains/entitlements/).
  capabilities String
  createdAt    DateTime @default(now())

  students Student[]
}

// --- Curriculum / progress -------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  modules Module[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  // Nullable: modules created before Course existed (or not yet categorized)
  // stay valid rather than forcing a backfill migration — see DATABASE.md §2.2.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  progress ModuleProgress[]
  lessons  Lesson[]
}

// --- Curriculum versioning (CURRICULUM_SYSTEM.md) --------------------------

enum LessonStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id         String       @id @default(cuid())
  moduleId   String
  title      String
  slug       String
  status     LessonStatus @default(DRAFT)
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // The version students currently see. Null until the first version is
  // published — editing after that creates a new LessonVersion rather than
  // mutating this one in place, so in-progress students / AI citations tied
  // to an old version keep resolving correctly (CURRICULUM_SYSTEM.md
  // "Versioning"). Publishing repoints this at the new version.
  currentVersionId String?
  currentVersion   LessonVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  versions  LessonVersion[] @relation("LessonVersions")
  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  concepts  Concept[]
  questions Question[]

  // Soft prerequisites only (CURRICULUM_SYSTEM.md "Prerequisites") — informational,
  // not enforced/gated in the UI yet.
  prerequisites   Lesson[] @relation("LessonPrerequisites")
  prerequisiteFor Lesson[] @relation("LessonPrerequisites")

  @@unique([moduleId, slug])
}

model LessonVersion {
  id                 String    @id @default(cuid())
  lessonId           String
  version            Int
  content            String // markdown; first content type per CURRICULUM_SYSTEM.md
  learningObjectives String?
  assessmentCriteria String?
  authorId           String?
  createdAt          DateTime  @default(now())
  publishedAt        DateTime?

  lesson     Lesson     @relation("LessonVersions", fields: [lessonId], references: [id], onDelete: Cascade)
  author     AdminUser? @relation(fields: [authorId], references: [id])
  currentFor Lesson[]   @relation("CurrentVersion")

  @@unique([lessonId, version])
}

model Concept {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  lessons        Lesson[]
  questions      Question[]
  masteries      ConceptMastery[]
  masteryEvents  ConceptMasteryEvent[]
  chartExercises ChartExercise[]
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model ModuleProgress {
  id        String         @id @default(cuid())
  studentId String
  moduleId  String
  status    ProgressStatus @default(NOT_STARTED)
  score     Int? // optional quiz score 0-100
  updatedAt DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
}

// --- Assessment (Phase 2, DATABASE.md §2.3) ---------------------------------

model Question {
  id           String   @id @default(cuid())
  lessonId     String
  prompt       String
  choices      String // JSON-encoded string[] — freeform count, not fixed at 4
  correctIndex Int
  explanation  String?
  createdAt    DateTime @default(now())

  lesson   Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concepts Concept[]
  attempts QuestionAttempt[]
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  studentId     String
  questionId    String
  selectedIndex Int
  correct       Boolean
  attemptedAt   DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  masteryEvents ConceptMasteryEvent[]
}

// --- Chart Lab (Phase 5) -----------------------------------------------------
// "What do you see?" — the AI never immediately grades or hands over an
// answer; it asks one Socratic follow-up question instead
// (AI_ARCHITECTURE.md "Planned: Socratic Chart Lab tutor"). Deliberately not
// a multi-round chat thread yet — one question -> one follow-up is the
// proof of pattern; a fuller back-and-forth is a later iteration once this
// shape is validated with real use.

model ChartExercise {
  id           String   @id @default(cuid())
  title        String
  prompt       String // the task, e.g. "Mark the most recent liquidity sweep"
  // Stored as a data: URL, not a file path — this app has no external blob
  // storage (matches the "zero external infra" ethos elsewhere), and chart
  // images are small enough for SQLite's TEXT column to hold comfortably at
  // demo scale. Revisit if/when real usage volume makes that not true.
  imageDataUrl String
  createdAt    DateTime @default(now())

  concepts Concept[]
  answers  ChartAnswer[]
}

model ChartAnswer {
  id               String   @id @default(cuid())
  studentId        String
  chartExerciseId  String
  response         String // student's free-text "what do you see"
  followUpQuestion String? // the AI's one Socratic follow-up
  followUpResponse String? // student's reply to the follow-up, if given
  createdAt        DateTime @default(now())

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chartExercise ChartExercise @relation(fields: [chartExerciseId], references: [id], onDelete: Cascade)
}

// --- Progression (Phase 2, DATABASE.md §2.5) --------------------------------

model Level {
  id          String   @id @default(cuid())
  name        String
  orderIndex  Int      @default(0)
  // A student's level is whichever Level has the highest xpThreshold <= their
  // total XP (see app/lib/domains/progression/level.ts) — admin-configurable
  // without a code change, per brief §5's explicit requirement.
  xpThreshold Int      @unique
  description String?
  createdAt   DateTime @default(now())
}

// Append-only ledger, not a mutable running total column — makes XP
// auditable and abuse-detectable (brief §19), and a student's total is
// always a SUM query over real events, never a value that can drift from
// its own history. See app/lib/domains/progression/xp.ts.
model XpEvent {
  id        String   @id @default(cuid())
  studentId String
  source    String // e.g. "QUIZ_CORRECT" — freeform, not an enum, so new sources need no migration
  amount    Int
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "FIRST_QUIZ_PASSED" — stable identifier the deterministic checker code references
  name        String
  description String?
  createdAt   DateTime @default(now())

  unlockedBy UserAchievement[]
}

// Achievements are validated server-side only (brief §18) — this table is
// only ever written by app/lib/domains/progression's deterministic checker
// functions, never by a client-reported "I did this" flag.
model UserAchievement {
  id            String   @id @default(cuid())
  studentId     String
  achievementId String
  unlockedAt    DateTime @default(now())

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
}

enum MasteryState {
  NOT_INTRODUCED
  INTRODUCED
  LEARNING
  UNDERSTOOD
  APPLIED
  CONSISTENT
  MASTERED
}

// Per-student, per-concept state (brief §7's ladder). `state` and
// `consecutiveCorrect` are both derived, by a pure function
// (app/lib/domains/progression/mastery.ts), from QuestionAttempt evidence —
// a wrong answer resets the streak but never downgrades `state` itself
// (only sustained old evidence should erode confidence, per
// CURRICULUM_SYSTEM.md's "decays when evidence is old" — the actual decay
// curve is still undecided/not built; `lastEvidenceAt` is captured now so
// that piece can be added without another migration).
model ConceptMastery {
  id                 String       @id @default(cuid())
  studentId          String
  conceptId          String
  state              MasteryState @default(NOT_INTRODUCED)
  consecutiveCorrect Int          @default(0)
  lastEvidenceAt     DateTime?
  updatedAt          DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
}

// Append-only evidence ledger for concept mastery — the *trajectory*, not just
// where a student currently stands.
//
// `ConceptMastery` above is a derived snapshot that gets OVERWRITTEN on every
// graded answer: the upsert in gradeAttempt() replaces `state`,
// `consecutiveCorrect` and `lastEvidenceAt`, so how a student arrived there
// (when a concept first clicked, how many times they fell back, how long a
// streak held before it broke) is destroyed on write. That path is the part
// worth keeping — a snapshot answers "do they know this?", the path answers
// "how do people learn this, and who is about to slip?".
//
// Same shape and same reasoning as XpEvent: record every event, derive the
// total, never trust a mutable running value that can drift from its own
// history.
//
// One row per piece of evidence APPLIED, not only per state change. A correct
// answer that leaves state unchanged (already MASTERED) is still evidence, and
// the streak it extends is signal. Query `fromState != toState` when only the
// transitions are wanted.
model ConceptMasteryEvent {
  id        String @id @default(cuid())
  studentId String
  conceptId String
  // The attempt this evidence came from — an observation always points at the
  // record that produced it, the same discipline AiInsight follows. Nullable
  // and SetNull rather than Cascade: a future non-quiz evidence source (Chart
  // Lab, simulator) can write here without a migration, and deleting an
  // attempt must never silently rewrite a student's mastery history.
  attemptId String?

  correct    Boolean
  fromState  MasteryState
  toState    MasteryState
  fromStreak Int
  toStreak   Int
  createdAt  DateTime     @default(now())

  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempt QuestionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([studentId, conceptId, createdAt])
}

// --- Notes / CRM activity ---------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  AdminUser? @relation(fields: [authorId], references: [id])
}

enum CrmActivityType {
  STATUS_CHANGE
  FOLLOW_UP
  EMAIL_DRAFTED
  MANUAL_LOG
}

model CrmActivity {
  id        String          @id @default(cuid())
  studentId String
  type      CrmActivityType
  summary   String
  createdAt DateTime        @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// --- Knowledge base / retrieval --------------------------------------------

enum DocumentStatus {
  PROCESSING
  READY
  ERROR
}

// Whose authority this document carries, once confirmed — orthogonal to
// isSample ("is this fake demo content") and needsReview ("is this real but
// unconfirmed"): a needsReview doc can already have its intended trustLevel
// set, with needsReview flagging it isn't confirmed YET. See
// AI_ARCHITECTURE.md "Planned: knowledge trust levels" for the full design.
enum TrustLevel {
  A_OFFICIAL
  B_INSTRUCTOR_APPROVED
  C_REFERENCE
  D_COMMUNITY
}

model Document {
  id          String         @id @default(cuid())
  title       String
  sourceType  String // "markdown_upload" | "manual_entry" | "transcript" (extensible, not an enum)
  rawContent  String
  status      DocumentStatus @default(PROCESSING)
  isSample    Boolean        @default(false) // true for seeded placeholder content, never presented as the real methodology
  needsReview Boolean        @default(false) // true for content extracted/drafted from another source and not yet confirmed accurate by an admin — distinct from isSample (which means "fake demo content"), this means "real but unconfirmed"
  trustLevel  TrustLevel     @default(C_REFERENCE)
  tags        String? // comma-separated
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  ordinal    Int
  content    String
  createdAt  DateTime @default(now())

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations Citation[]
}

// --- AI chat -----------------------------------------------------------------

enum ConversationScope {
  STUDENT
  ADMIN
}

model Conversation {
  id        String            @id @default(cuid())
  scope     ConversationScope @default(ADMIN)
  studentId String?
  title     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  provider       String // "mock" | "anthropic" — which AI provider generated this (ASSISTANT only)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]
}

// Links an assistant Message to the DocumentChunk(s) it cited, so every
// AI answer can show "source: <document title>" — never an uncited claim.
model Citation {
  id        String @id @default(cuid())
  messageId String
  chunkId   String
  score     Float // retrieval similarity score, for transparency/debugging

  message Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

// --- Trading journal ----------------------------------------------------------

model JournalTrade {
  id         String   @id @default(cuid())
  studentId  String
  symbol     String
  direction  String // long/short
  entryPrice Float?
  exitPrice  Float?
  result     String? // win/loss/breakeven
  rMultiple  Float?
  setupTag   String? // e.g. "displacement+FVG", freeform, not constrained to a fixed enum
  mistakeTag String? // recurring execution/process mistake label
  notes      String?
  tradedAt   DateTime
  createdAt  DateTime @default(now())

  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  insights AiInsight[]
}

// Evidence-linked pattern observations over a student's own journal, kept in
// a separate table from JournalTrade.notes (the student's own words) so an
// AI-generated observation can never silently overwrite a student's own
// reflection — brief §14/§15's requirement enforced at the schema level, not
// just a UI convention. `provider` records what actually generated the text
// (see app/lib/domains/journal/insights.ts — deterministic pattern text
// today, not yet wired to the AiProvider interface used elsewhere; see that
// file's header comment for why).
model AiInsight {
  id        String   @id @default(cuid())
  studentId String
  summary   String
  provider  String
  createdAt DateTime @default(now())

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trades  JournalTrade[]
}

// --- Audit / approvals ---------------------------------------------------------

enum AuditAction {
  AI_CHAT_QUERY
  AI_CHAT_RESPONSE
  DOCUMENT_UPLOADED
  STUDENT_CREATED
  STUDENT_UPDATED
  NOTE_ADDED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  LOGIN
  LESSON_CREATED
  LESSON_UPDATED
  LESSON_PUBLISHED
  QUESTION_CREATED
  CHART_EXERCISE_CREATED
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  detail    String // human-readable summary
  metadata  String? // JSON-encoded extra context
  createdAt DateTime    @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id])
}

// Sensitive/business-impacting AI-proposed actions (e.g. "send this email",
// "change student status to CHURNED") land here for human approval instead
// of executing automatically. Nothing in this schema lets an AI action
// bypass this table for anything marked sensitive.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id          String         @id @default(cuid())
  requestedBy String? // AdminUser id, or null if AI-originated
  actionType  String // e.g. "SEND_EMAIL", "STATUS_CHANGE"
  payload     String // JSON-encoded proposed action
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  decidedBy AdminUser? @relation(fields: [decidedById], references: [id])
}
