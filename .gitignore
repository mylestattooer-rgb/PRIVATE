# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/dev.db
/prisma/dev.db
/prisma/test.db
*.db-journal


# Generated flash sheets — ~19MB, rebuilt by flash/build.mjs on demand
/flash/sheets.html
/flash/test-sheet.html

# Obsidian — per-machine state only.
# The shared vault config (.obsidian/app.json, appearance.json, graph.json) IS tracked
# on purpose, so every clone opens the vault with the same settings.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/hotkeys.json
.obsidian/plugins/
.obsidian/themes/
.obsidian/snippets/
.trash/
